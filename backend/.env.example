# Copy to backend/.env and replace placeholders. Never commit real credentials.
DATABASE_URL=postgresql://cutcrew:replace-with-local-password@127.0.0.1:5432/cutcrew
# Migration script only: source MongoDB (read-only). Not used by the backend.
PORT=5000
SCRAPER_URL=https://cut-crew-all.onrender.com
# IMDb scraper failures fall back to Cinemeta automatically.
ADMIN_TOKEN=replace-with-a-long-random-secret
MEDIA_TOKEN_SECRET=replace-with-a-different-long-random-secret
# Optional comma-separated provider allowlist, in adapter folder-name spelling.
# ENABLED_PROVIDERS=4khdhub,internetArchive
# Playback sources, tried together and ranked in this order. Remove a name, or
# set SOURCE_<NAME>=off (e.g. SOURCE_CENSORED=off), to turn one off. vega-style
# names (4khdhub, internetArchive) also need ENABLED_PROVIDERS.
# MULTI_SOURCE=false goes back to one provider at a time.
# STREAM_SOURCES=desiflix,hdhub,censored,pengu,4khdhub,internetArchive
# Stremio add-ons as name=link pairs. Without this line the public DesiFlix,
# HdHub and CENSORED add-ons are used. PenguPlay needs your own signed-in link
# (without it, it only returns a "You must sign in" video).
# STREMIO_ADDONS=desiflix=https://manifest.desitvhub.eu.org,hdhub=https://hdhub.thevolecitor.qzz.io,censored=https://censoredaddon.vercel.app,pengu=https://pengu.uk/<your-config>
# SOURCE_TIMEOUT_MS=10000        # Stremio add-ons (CENSORED_TIMEOUT_MS 20000, PENGU_TIMEOUT_MS 25000)
# VEGA_SOURCE_TIMEOUT_MS=25000   # vega-style providers (search + page + stream)
# SOURCE_WAIT_MS=10000           # answer after this once something plays
# SOURCE_AUTO_DISABLE_AFTER=2    # weekly checks in a row with nothing playable
# IA_MAX_YEAR=1980               # Internet Archive only for films up to this year
# Per-provider settings, as JSON. Example: only public-domain films from Internet Archive.
# PROVIDER_SETTINGS={"internetArchive":{"licenses":"publicDomain"}}
# Override the upstream registry if its published address changes.
# PROVIDER_REGISTRY_URL=https://your-registry.example/providers.json
# Per-provider base URLs take precedence over the registry. JSON values are URL strings.
# PROVIDER_BASE_URLS={"rive":"https://your-working-provider.example"}

# Required for MKV/browser codec conversion: install FFmpeg and ffprobe on the server.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_REMUX_STREAMS=2

# Allowed frontend origins for credentialed account requests (comma-separated).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional PostgreSQL backup executable and output directory.
# PG_DUMP_PATH=pg_dump
# BACKUP_DIR=.local/backups
# Account email delivery (no external email is sent until SMTP is configured).
# APP_URL=http://localhost:5173
# SMTP_HOST=smtp.your-email-service.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-user
# SMTP_PASSWORD=your-password
# MAIL_FROM=CutCrew <no-reply@your-domain.example>
# Explicit local testing only: writes emails into ignored backend/.local/mail.
# MAIL_TRANSPORT=file
# Optional conversion controls. Default: no artificial input-rate cap.
# REMUX_READ_RATE=0
# FFMPEG_THREADS=4

# Telegram Phase 0: operator-only feasibility tests, normal playback stays unchanged.
TELEGRAM_STORAGE_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STORAGE_CHANNEL_ID=
TELEGRAM_BOT_API_URL=http://127.0.0.1:8081
TELEGRAM_SESSION_PATH=.local/telegram/bot.session
TELEGRAM_REQUEST_TIMEOUT_MS=30000
TELEGRAM_UPLOAD_TIMEOUT_MS=1800000

# Telegram Phase 1: storage index settings (defaults shown). Storage stays off
# unless TELEGRAM_STORAGE_ENABLED=true AND every Telegram value above is valid.
# VIDEO_PART_SIZE_BYTES=1500000000
# VIDEO_UPLOAD_CONCURRENCY=2
# VIDEO_IMPORT_MAX_ATTEMPTS=5
# VIDEO_JOB_LEASE_MS=120000
# Large scratch files (test fixtures, prepared videos, parts). Default:
# %LOCALAPPDATA%\CutCrew\... so OneDrive never syncs multi-GB files.
# TELEGRAM_WORK_DIR=
# VIDEO_WORK_DIR=

# Telegram Phase 3: streaming stored videos (defaults shown).
# TELEGRAM_DOWNLOAD_SESSIONS=4
# TELEGRAM_DOWNLOAD_INFLIGHT=2
# STREAM_FETCH_CONCURRENCY=8
# STREAM_PREFETCH_BYTES=25165824
# STREAM_CACHE_MAX_BYTES=4294967296
# STREAM_CACHE_DIR=
# STREAM_TICKET_TTL_MS=21600000

# Auto-save: a provider title watched for a few minutes is downloaded once and
# saved to Telegram in the background. Needs TELEGRAM_STORAGE_ENABLED=true.
# Uses bandwidth (download + upload) and up to ~3x the film size in free disk.
AUTO_ARCHIVE_ENABLED=false
# AUTO_ARCHIVE_MIN_WATCH_SECONDS=300
# AUTO_ARCHIVE_DAILY_LIMIT=10
# AUTO_ARCHIVE_MAX_HEIGHT=1080
# AUTO_ARCHIVE_MAX_BYTES=8000000000
# AUTO_ARCHIVE_MAX_ATTEMPTS=3
# AUTO_ARCHIVE_WORK_DIR=
