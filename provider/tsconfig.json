{
  "compilerOptions": {
    "target": "es2015",
    "module": "commonjs",
    "rootDir": "./movie",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["movie/**/*"],
  "exclude": ["node_modules", "dist", "movie/nuvio", "anime", "nuvio-runner"]
}
