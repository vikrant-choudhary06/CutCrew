{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CutCrew",
  "version": "1.0.4",
  "identifier": "sbs.vikrant.cutcrew",
  "build": {
    "frontendDist": "../offline"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CutCrew",
        "url": "https://web.cutcrew.click",
        "width": 1280,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "CutCrew",
    "shortDescription": "Movies and series",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
